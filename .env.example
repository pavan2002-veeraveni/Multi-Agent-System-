# ============================================================
# Multi-Agent Market Research & Report Generator
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.

# OpenAI API Key (Required - powers the manager LLM and agents)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Tavily API Key (Primary search provider)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# SerperDev API Key (Fallback search provider)
SERPER_API_KEY=your-serper-api-key-here

# Optional: Override the default manager LLM model
# MANAGER_LLM_MODEL=gpt-4o
